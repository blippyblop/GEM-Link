;
; XIddDriver.inf
;

[Version]
PnpLockDown=1
Signature="$Windows NT$"
ClassGUID = {4D36E968-E325-11CE-BFC1-08002BE10318}
Class = Display
ClassVer = 2.0
Provider=%ManufacturerName%
CatalogFile=XIddDriver.cat
DriverVer= ; TODO: set DriverVer in stampinf property pages

[Manufacturer]
%ManufacturerName%=Standard,NT$ARCH$.10.0...19041

[Standard.NT$ARCH$.10.0...19041]
%DeviceName%=MyDevice_Install, Root\XIddDriver ; TODO: edit hw-id, this hardware id is used by Visual Studio remote debugging
%DeviceName%=MyDevice_Install, XIddDriver      ; TODO: edit hw-id, this hardware if is used by the XIddApp.exe

[SourceDisksFiles]
XIddDriver.dll=1

[SourceDisksNames]
1 = %DiskName%

; =================== UMDF Device ==================================

; NOTE: the MS sample uses Include=WUDFRD.inf / Needs=WUDFRD.NT* here. That is
; the Windows 11 shape: on Windows 10 19045 the .hw include fails outright and
; the services section never sets SPSVCINST_ASSOCSERVICE, so install dies with
; "No INF AddService directives contained the flag SPSVCINST_ASSOCSERVICE".
; VD's shipped vdvmd.inf declares the reflector service EXPLICITLY instead, and
; that is the configuration proven to work on this OS. Adopted.
[MyDevice_Install.NT]
CopyFiles=UMDriverCopy

[MyDevice_Install.NT.hw]
AddReg = MyDevice_HardwareDeviceSettings

[MyDevice_HardwareDeviceSettings]
HKR,, "UpperFilters",  %REG_MULTI_SZ%, "IndirectKmd"
HKR, "WUDF", "DeviceGroupId", %REG_SZ%, "XIddDriverGroup"
; Allow generic-all access to Built-in administrators and Local system.
; Taken from VD's proven vdvmd.inf: without it CreateFile() on the device
; returns ACCESS_DENIED, so no companion app (or harness) can open it.
HKR,, "Security",, "D:P(A;;GA;;;BA)(A;;GA;;;SY)"

[MyDevice_Install.NT.Services]
AddService=WUDFRd,0x000001fa,WUDFRD_ServiceInstall

[MyDevice_Install.NT.Wdf]
UmdfService=XIddDriver,XIddDriver_Install
UmdfServiceOrder=XIddDriver
UmdfKernelModeClientPolicy = AllowKernelModeClients

[XIddDriver_Install]
UmdfLibraryVersion=$UMDFVERSION$
ServiceBinary=%12%\UMDF\XIddDriver.dll
UmdfExtensions = IddCx0102

[WUDFRD_ServiceInstall]
DisplayName   = %WudfRdDisplayName%
ServiceType   = 1
StartType     = 3
ErrorControl  = 1
ServiceBinary = %12%\WUDFRd.sys

[DestinationDirs]
UMDriverCopy=12,UMDF ; copy to drivers\umdf

[UMDriverCopy]
XIddDriver.dll

; =================== Generic ==================================

[Strings]
ManufacturerName="<Your manufacturer name>" ; TODO: Replace with your manufacturer name
WudfRdDisplayName = "Windows Driver Foundation - User-mode Driver Framework Reflector"
DiskName = "XIddDriver Installation Disk" ; TODO: Replace with driver disk name
DeviceName="XIddDriver Device" ; TODO: Replace with correct device name

REG_MULTI_SZ  = 0x00010000
REG_SZ        = 0x00000000
